{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "声屿",
  "version": "0.1.0",
  "identifier": "com.voiceisland.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "声屿",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:7880 http://localhost:8787 https: wss:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "简单、清晰的桌面语音聊天室",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBRThCODg0NTRGRDdFMgpSV1RpMTA5RmlJdXVBWWRoNnRwUWk5Vjk2MkhVWGhobSs5aHpQNzBhUWpZTFhpTkpWKzZsVkQ5eAo=",
      "endpoints": [
        "https://github.com/LZW0506/voice-room/releases/latest/download/latest.json"
      ]
    }
  }
}
